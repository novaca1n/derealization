<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/clock_frame" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|top" android:gravity="center_horizontal|top" android:orientation="vertical">

    <TextClock android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:format12Hour="hh:mm" android:format24Hour="HH:mm" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:tag="accent1|nolineheight|clockfont" android:textAlignment="center" android:textColor="@android:color/white" android:textSize="70sp" />

    <TextClock android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="EEEE, MMMM dd" android:format24Hour="EEEE, dd MMMM" android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:tag="text1|clockfont" android:textAlignment="center" android:textColor="@android:color/white" android:textSize="20sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">

        <dev.novacain.ntclocks.faces.crd.WeatherImageView android:id="@+id/weather_image" android:layout_width="20sp" android:layout_height="20sp" android:layout_gravity="center_vertical" android:layout_marginEnd="4dp" android:scaleType="fitCenter" android:visibility="gone" />

        <dev.novacain.ntclocks.faces.crd.WeatherTextView android:id="@+id/weather_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:layout_marginStart="4dp" android:textColor="@android:color/white" android:visibility="gone" android:textSize="20sp" android:tag="clockfont" />
    </LinearLayout>

</LinearLayout>