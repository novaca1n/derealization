<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layout_gravity="start|center_vertical">

    
    <TextView android:id="@+id/its_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="It's" android:textSize="62sp" android:textColor="@android:color/system_accent1_300" android:layout_marginStart="4dp" android:layout_marginBottom="6dp" android:tag="clockfont" />

    
    <dev.novacain.ntclocks.faces.crd.WordClockView android:id="@+id/word_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:lineSpacingExtra="8dp" android:textSize="64sp" android:textColor="@android:color/white" android:tag="clockfont" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:layout_gravity="start|center_vertical">

        <dev.novacain.ntclocks.faces.crd.WeatherImageView android:id="@+id/weather_image" android:layout_width="20sp" android:layout_height="20sp" android:layout_marginEnd="4dp" android:scaleType="fitCenter" android:visibility="gone" />

        <dev.novacain.ntclocks.faces.crd.WeatherTextView android:id="@+id/weather_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="@android:color/white" android:visibility="gone" android:textSize="20sp" android:tag="clockfont" />
    </LinearLayout>
</LinearLayout>