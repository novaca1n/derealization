    <string name="news_store">TweakStore</string>
    <string name="news_store_text">Patching also installs TweakStore — extra tweaks live there, from the official source and any source you add.</string>
    <string name="news_clocks">Lock screen clocks</string>
    <string name="news_clocks_text">Dot matrix, stretched digits, analog, iOS, ColorOS and OriginOS styles and 67 styles from crDroid — with live preview.</string>
    <string name="news_depth">Depth for any wallpaper</string>
    <string name="news_depth_text">Put any photo on the lock screen: the subject is found automatically, fix it with your finger, and it stands over the clock.</string>
    <string name="news_motion">ColorOS 17 motion</string>
    <string name="news_motion_text">Springy app launch and close, folders, app drawer and a rubber-band shade — across the whole system.</string>
    <string name="news_ios">iPhone-style details</string>
    <string name="news_ios_text">Heads-up notifications drop in from above, a glass volume capsule, and an unlock where the clock slides away.</string>
    <string name="news_home">Living home screen</string>
    <string name="news_home_text">Icons settle row by row after unlocking, a ripple when an app closes — and shake the phone for gravity.</string>
    <string name="news_resize">Resize like widgets</string>
    <string name="news_resize_text">Long-press an icon or folder and drag a corner: 2×1, 1×2, 2×2 and more.</string>
    <string name="news_glass">Glass and colors</string>
    <string name="news_glass_text">A glass shade and app drawer, a split shade like Nothing OS 5, and a color engine for the whole system.</string>
    <string name="news_settings">Settings where they belong</string>
    <string name="news_settings_text">Everything is in Wallpaper &amp; style → derealization, next to Nothing\'s own settings.</string>
    <string name="news_safe">Safe mode</string>
    <string name="news_safe_text">If a patched app crashes three times in a row, derealization steps out of it until you patch again.</string>
